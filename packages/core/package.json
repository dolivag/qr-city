{
  "name": "@qr-city/core",
  "version": "0.3.0",
  "description": "A 3D isometric city whose rooftops form a scannable QR code. Framework-agnostic core built on three.js.",
  "keywords": ["qr", "qrcode", "three", "threejs", "3d", "isometric", "webgl"],
  "license": "MIT",
  "author": "Dani Oliva",
  "repository": { "type": "git", "url": "git+https://github.com/dolivag/qr-city.git", "directory": "packages/core" },
  "type": "module",
  "sideEffects": ["./dist/ultra.js"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./ultra": { "types": "./dist/ultra.d.ts", "import": "./dist/ultra.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": { "qrcode-generator": "^2.0.4" },
  "peerDependencies": { "three": ">=0.160.0 <1" }
}
